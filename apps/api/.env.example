# Template for apps/api/.env, which is gitignored and must never be committed.
#
# Easiest: run `npm run setup` from the repository root. It copies this file and
# fills JWT_SECRET with a freshly generated value.
#
# By hand: copy to .env and set JWT_SECRET yourself. It is left empty here on
# purpose, so a blind copy fails loudly at startup rather than running everyone's
# clone on the same well-known secret.
NODE_ENV=development
PORT=4000

# Local Mongo via `docker compose up -d`, or a MongoDB Atlas connection string.
# `replicaSet=rs0` matches docker-compose.yml. MongoDB only supports
# multi-document transactions on a replica set, so development runs one node as
# a set; Atlas connection strings are already replica sets.
MONGODB_URI=mongodb://127.0.0.1:27017/baby_tracker?replicaSet=rs0

# Origin allowed to send credentialed requests (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=info

# Signs access tokens. At least 32 characters; required in every environment.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Access token lifetime in seconds (default 900 = 15 minutes).
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime in days (default 30). Reset on every rotation.
REFRESH_TOKEN_TTL_DAYS=30

# Refresh-cookie attributes. COOKIE_SECURE defaults to true in production and
# false elsewhere, and must never be false in production.
# COOKIE_SECURE=false
# lax | strict | none. `none` requires COOKIE_SECURE=true and, per
# docs/phase-1a-auth.md §8, CSRF protection.
COOKIE_SAMESITE=lax

# Reverse proxies in front of the API. 0 locally; 1 on Render.
# TRUST_PROXY=0
