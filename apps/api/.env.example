# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000

# Local Mongo via `docker compose up -d`, or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/baby_tracker

# Origin allowed to send credentialed requests (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=info
