{
  "name": "@baby-tracker/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Domain types, validation schemas, unit conversion and time helpers shared by the API and the web app.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch --preserveWatchOutput",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^4.5.4"
  }
}
